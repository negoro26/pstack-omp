# Open upstream fix to check-plan.mjs, carried until cursor/plugins merges it: the check-plan half
# of #745 (rollup of #672). A code span opened by two or more backticks now closes only on a run of
# the same length, so prose punctuation inside ``a `b`: c`` is not reported. The worktree-audit
# half of #745 is not here; worktree-audit-omp.patch owns that script.
#
diff --git a/skills/poteto-mode/scripts/check-plan.mjs b/skills/poteto-mode/scripts/check-plan.mjs
--- a/skills/poteto-mode/scripts/check-plan.mjs
+++ b/skills/poteto-mode/scripts/check-plan.mjs
@@ -72,7 +72,7 @@ for (let i = start; i < raw.length; i++) {
 	lines.push({ n, text, code });
 	if (code) continue;
 	const prose = text
-		.replace(/`[^`]*`/g, "`")
+		.replace(/(?<!`)(`+)(?!`)(.*?)(?<!`)\1(?!`)/g, "`")
 		.replace(/!\[[^\]]*\]\([^)]*\)/g, "")
 		.replace(/\]\([^)]*\)/g, "]");
 	if (/[\u2013\u2014]/.test(prose)) fail(n, "long dash");
diff --git a/skills/poteto-mode/scripts/check-plan.test.ts b/skills/poteto-mode/scripts/check-plan.test.ts
--- a/skills/poteto-mode/scripts/check-plan.test.ts
+++ b/skills/poteto-mode/scripts/check-plan.test.ts
@@ -94,3 +94,17 @@ test("rejects backtick info strings containing a backtick", () => {
 	const result = runPlan("```markdown `invalid`\n## Example only\n```\n", 1);
 	expect(result.stderr).toContain('"## Example only" after Close the program is not an appendix');
 });
+
+test("ignores prose punctuation inside matching multi-backtick code spans", () => {
+	for (const count of [2, 3, 4]) {
+		const delimiter = "`".repeat(count);
+		runPlan(`Use ${delimiter}echo \`x\`: “quoted” — example${delimiter}.\n`, 0);
+	}
+});
+
+test("checks prose following a multi-backtick span and unmatched delimiters", () => {
+	const outside = runPlan("Use ``echo `x`: y``. Bad: prose.\n", 1);
+	expect(outside.stderr).toContain("mid-sentence colon");
+	const unmatched = runPlan("Use ``unclosed: bad` here.\n", 1);
+	expect(unmatched.stderr).toContain("mid-sentence colon");
+});
