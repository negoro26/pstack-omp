+		[ -d "$root/sessions/$own" ] && session_dirs+=("$root/sessions/$own/")
+		[ "$path" = "$main_wt" ] && continue
+		for dir in "$root/sessions/${sub%\**}"*"${sub##*\*}"; do
+			[ -d "$dir" ] && session_dirs+=("$dir/")
+		done
+	done
+	dotenvs+=("$path/.env")
+done < <(printf '%s\n' "$worktree_records" | awk '/^worktree /{sub(/^worktree /, ""); print}')
